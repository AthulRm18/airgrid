OPENAQ_API_KEY=your_openaq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Optional — Earth Engine (slow; off by default for fast local demo)
USE_EARTH_ENGINE=false
EE_SERVICE_ACCOUNT=
EE_PRIVATE_KEY_PATH=./ee-service-account.json
GCP_PROJECT_ID=

# Auto-seed the replayable demo scenario when the backend starts
DEMO_AUTO_SEED=true