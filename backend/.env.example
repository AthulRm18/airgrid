OPENAQ_API_KEY=your_openaq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite

# Earth Engine (Sentinel-5P aerosol) — your GCP project must have EE API enabled
# 1. Create service account + download JSON key into backend/
# 2. Register the SA at https://signup.earthengine.google.com/ (or EE console)
# 3. Set the vars below and restart the backend
USE_EARTH_ENGINE=false
GCP_PROJECT_ID=cognitive-late
EE_SERVICE_ACCOUNT=ee-runner@cognitive-late.iam.gserviceaccount.com
EE_PRIVATE_KEY_PATH=./ee-service-account.json

# Auto-seed demo scenario on startup
DEMO_AUTO_SEED=true

# Performance
OPENAQ_REQUEST_TIMEOUT=10
OPENAQ_TOTAL_TIMEOUT=25
GEMINI_EVIDENCE_TIMEOUT_SECONDS=12
